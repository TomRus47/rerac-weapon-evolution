+pub(crate) fn bomb_glove_aim_search(stats: Option<crate::weapon_evo::Stats>, table: &MobyTable, list: &[MobyId], from: [f32; 3], yaw: f32, mut clear: impl FnMut([f32; 3]) -> bool) -> Option<AimHit> {
+    let mut rules = BOMB_GLOVE;
+    if let Some(stats) = stats {
+        rules.range = stats.auto_lock_distance();
+        // launch_velocity falls back to throwing straight ahead beyond 50 deg.
+        rules.near_cone = rules.near_cone.min(f32::from_bits(0x3f5f_66f3));
