+#[cfg(test)]
+mod evolution_save_tests {
+    use super::*;
+    use crate::weapon_evo::save::{Progress, Track};
+    use rc_formats::save_game::{ChunkDesc, ChunkTables};
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    struct Temp(PathBuf);
+    impl Temp {
+        fn new() -> Self {
+            static NEXT: AtomicU64 = AtomicU64::new(0);
+            let p = std::env::temp_dir().join(format!("rerac-card-evo-{}-{}", std::process::id(), NEXT.fetch_add(1, Ordering::Relaxed)));
+            std::fs::create_dir_all(p.join("TEST")).unwrap(); Self(p)
+        }
+    }
+    impl Drop for Temp { fn drop(&mut self) { let _ = std::fs::remove_dir_all(&self.0); } }
+    fn state() -> GameState {
+        GameState::zeroed(ChunkTables { global: vec![ChunkDesc { addr: 0x1000, id: 0, size: 4 }], level: vec![] })
+    }
+    fn progress(level: u32, xp: f32) -> Progress {
+        let mut p = Progress::default(); p.tracks[1] = Track { level, xp }; p
+    }
+    fn slot(tmp: &Temp, n: usize) -> PathBuf { tmp.0.join("TEST").join(rc_formats::save_game::save_file_name(n)) }
+    fn card(tmp: &Temp, gs: &GameState) -> MemCard {
+        for n in 0..2 { std::fs::write(slot(tmp, n), gs.to_save_file().to_bytes()).unwrap(); }
+        MemCard::new(CardFs::new(Some(tmp.0.clone())), "/TEST".into(), None)
+    }
+    fn drive(c: &mut MemCard, gs: &mut GameState, state: i32) {
+        c.state = state; c.sub = 0; c.busy = false; c.pending = None; c.req_state = -1;
+        if state == 0xe { c.level = 0; }
+        c.error = 0;
+        for _ in 0..500 {
+            c.update(gs);
+            if c.state == 0 && !c.busy { assert_eq!(c.error, 0); return; }
+        }
+        panic!("card operation did not finish: {}:{}", c.state, c.sub);
+    }
+
+    #[test]
+    fn whole_save_uses_prepared_progress_and_loading_slots_restores_separate_values() {
+        let tmp = Temp::new(); let mut gs = state(); let mut c = card(&tmp, &gs);
+        let a = progress(3, 2.5); let b = progress(4, 9.125);
+        gs.weapon_progress = a; gs.global.level = 2;
+        c.save_whole(&mut gs, 0, &SaveCapture::default()); let expected_native = c.whole.clone();
+        gs.weapon_progress = b; gs.global.level = 4;
+        drive(&mut c, &mut gs, 0x14);
+        assert_eq!(std::fs::read(slot(&tmp, 0)).unwrap(), expected_native);
+        c.save_whole(&mut gs, 1, &SaveCapture::default()); drive(&mut c, &mut gs, 0x14);
+        let mut loaded = state(); c.card.slot = 0; drive(&mut c, &mut loaded, 0xe);
+        assert_eq!((loaded.global.level, loaded.weapon_progress), (2, a));
+        assert_eq!(c.card.errors, 0);
+        c.card.slot = 1; drive(&mut c, &mut loaded, 0xe);
+        assert_eq!((loaded.global.level, loaded.weapon_progress), (4, b));
+    }
+
+    #[test]
+    fn autosave_captures_xp_once_and_new_game_clears_an_overwritten_slot() {
+        let tmp = Temp::new(); let mut gs = state(); let mut c = card(&tmp, &gs);
+        let a = progress(3, 4.5); gs.weapon_progress = a; gs.global.level = 2; c.checked = true; c.card.slot = 0;
+        assert!(c.memcard_save(&mut gs, false, -1, &SaveCapture::default()));
+        gs.weapon_progress = progress(4, 1.0);
+        drive(&mut c, &mut gs, 0x10);
+        c.card.slot = 0; drive(&mut c, &mut gs, 0xe); assert_eq!(gs.weapon_progress, a);
+        c.new_game_save(&mut gs, 0, [0; 8], |g| *g = state());
+        drive(&mut c, &mut gs, 0x14);
+        gs.weapon_progress = a; c.card.slot = 0; drive(&mut c, &mut gs, 0xe);
+        assert_eq!(gs.weapon_progress, Progress::default());
+    }
+
+    #[test]
+    fn legacy_slot_load_resets_progress_but_previews_do_not_change_it() {
+        let tmp = Temp::new(); let mut gs = state(); let mut c = card(&tmp, &gs);
+        let a = progress(4, 12.5); gs.weapon_progress = a;
+        let path = c.slot_file(1); c.fd = c.fs.open(&path, open_mode::READ);
+        c.state = 0x17; c.sub = 8; c.busy = false; c.card.errors = 0;
+        c.update(&mut gs); assert_eq!(gs.weapon_progress, a);
+        c.card.slot = 1; drive(&mut c, &mut gs, 0xe);
+        assert_eq!(gs.weapon_progress, Progress::default());
+        assert_eq!(c.card.errors, 0);
+    }
+
+    #[test]
+    fn companion_write_failure_does_not_commit_the_native_save() {
+        let tmp = Temp::new(); let gs = state(); let mut c = card(&tmp, &gs);
+        let before = std::fs::read(slot(&tmp, 0)).unwrap();
+        std::fs::write(tmp.0.join("TEST/weapon_evolution"), b"not a directory").unwrap();
+        let path = c.slot_file(0); let fd = c.fs.open(&path, open_mode::WRITE);
+        assert!(fd >= 0); c.fs.write(fd, b"replacement"); c.fs.attach_evolution(fd, progress(3, 1.0));
+        assert_eq!(c.fs.close(fd), mc::DENIED);
+        assert_eq!(std::fs::read(slot(&tmp, 0)).unwrap(), before);
+    }
+
+    #[test]
+    fn native_bytes_stay_identical_and_challenge_mode_keeps_weapon_progress() {
+        let mut gs = state(); let native = gs.to_save_file().to_bytes();
+        let a = progress(4, 7.5); gs.weapon_progress = a;
+        assert_eq!(gs.to_save_file().to_bytes(), native);
+        gs.challenge_reset(&[], |g| *g = state());
+        assert_eq!(gs.weapon_progress, a);
+    }
