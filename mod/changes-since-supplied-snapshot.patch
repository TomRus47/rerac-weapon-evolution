+; ReRAC Weapon Evolution - international default configuration
+; Only the real-HP damage system is supported: 1 native HP = 100 HP.
+; damage_hp is damage per projectile/explosion; damage_per_second is HP/s.
+; Separate attack instances can damage an enemy immediately; each hits it once.
+; Only HP actually removed from eligible enemies awards XP. Overkill gives no extra XP.
+; XP thresholds apply separately to each transition, not as cumulative totals.
+; ammo_interval_ticks and damage_interval_ticks are independent, per grade.
+; 60 game ticks = 1 second, independently of rendering FPS.
+; Stream damage accumulates only on actual contact and is registered every N contact ticks.
+; gold_effects enables original Gold mechanics; gold_texture controls appearance only.
+; Colors: default = original, or RRGGBB / #RRGGBB for custom RGB.
+; In-game weapon names always follow the selected game language.
+; name_opacity_percent controls the HUD weapon name, grade and their background.
+; 100 = normal, 50 = semi-transparent, 0 = hidden; it does not affect the 3D model.
+; The XP bar follows the ammo panel fade and stays aligned with its outer edges.
+; xp_bar_horizontal_inset_px affects the name position, not the XP bar span.
+; Taunter wave_* settings affect visuals only, not attraction, damage or stun.
+; wave_alpha: 0..128. Wave interval: 1..600 ticks. Wave multipliers: 0.1..8.
+; Devastator visual explosion size is independent of its damage radius.
+; Morph-o-Ray fire_in_air is per grade; running fire is always allowed.
+; Walloper air_dash_enabled controls airborne dashes at each grade.
+; Close the launcher before editing this file manually, then reopen it.
+; The launcher loads weapons.ini at every startup. Named presets are optional.
+; Save and launch uses these values directly when nothing has been edited.
+
+[general]
+damage_mode = real_hp
+xp_per_damage = 0.12
+
+[hud]
+level_up_popup = true
+level_up_popup_duration_seconds = 3.0
+level_up_sound = help_notice
+name_opacity_percent = 100
+show_for_weapons_without_ammo = true
+xp_bar_height_px = 5
+xp_bar_horizontal_inset_px = 2
+
+
