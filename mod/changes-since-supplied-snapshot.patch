+            let gravity = dt * dt * 11.0;
+            let vel = crate::hero::weapons::launch_velocity(gravity, 8.5 * stats.throw_range, yaw, from, point);
+            let dx = point[0] - from[0];
+            let dy = point[1] - from[1];
+            let time = (dx * dx + dy * dy).sqrt() / (8.5 * dt);
+            // Reject the solver's near-target/angle fallback and clipped arcs.
+            let predicted = [from[0] + vel[0] * time, from[1] + vel[1] * time,
+                from[2] + vel[2] * time - gravity * time * time * 0.5];
+            if (0..3).any(|k| (predicted[k] - point[k]).abs() > 0.01) { return false; }
+        }
