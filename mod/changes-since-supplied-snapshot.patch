+/// Extra yaw around a branch root's own position in model space. The parent
+/// transform and sibling branches are untouched; descendants inherit the rotation.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct JointYaw { pub joint: u8, pub radians: f32 }
+
+fn apply_joint_yaw(rows: &mut [V4; 4], joint: usize, yaws: &[JointYaw]) {
+    for yaw in yaws.iter().filter(|y| y.joint as usize == joint && y.radians != 0.0 && y.radians.is_finite()) {
+        let (s, c) = yaw.radians.sin_cos();
+        // Rotate the three basis vectors about model Z, preserving the hip pivot.
+        // Children are composed after this step in both palette and chain paths.
+        for row in rows.iter_mut().take(3) {
+            let (x, y) = (f32::from_bits(row[0]), f32::from_bits(row[1]));
+            row[0] = (c * x - s * y).to_bits();
+            row[1] = (s * x + c * y).to_bits();
+        }
+    }
+}
