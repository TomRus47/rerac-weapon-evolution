+/// Keep alpha and native peak brightness, including the 255-bright muzzle core.
+fn tint(native: u32, color: Option<u32>) -> u32 {
+    let Some(rgb) = color else { return native };
+    let peak = (native & 255).max((native >> 8) & 255).max((native >> 16) & 255);
+    let channel = |shift: u32| ((((rgb >> shift) & 255) * peak + 127) / 255) << shift;
+    (native & 0xff00_0000) | channel(0) | channel(8) | channel(16)
+}
+
+fn light_color(native: [f32; 3], color: Option<u32>) -> [f32; 3] {
+    color.map_or(native, |rgb| {
+        let peak = native[0].max(native[1]).max(native[2]);
+        crate::weapon_evo::rgb_float(rgb).map(|v| v * peak)
+    })
+}
